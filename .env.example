# Copy to .env (never commit .env) and fill in one provider.
# offline (default) | fake | openai | anthropic
TASKFLOW_LLM_PROVIDER=offline

# Model id exactly as your provider names it.
TASKFLOW_LLM_MODEL=

# OpenAI-compatible endpoints (OpenAI, OpenRouter, Together, Groq, vLLM, Ollama, ...):
OPENAI_API_KEY=
# TASKFLOW_LLM_BASE_URL=https://openrouter.ai/api/v1
# TASKFLOW_LLM_BASE_URL=http://localhost:11434/v1     # local Ollama, no key needed

# Anthropic Messages API:
ANTHROPIC_API_KEY=

TASKFLOW_LLM_TEMPERATURE=0
